---
import Base from '../../layouts/Base.astro';
import Badges from '../../components/Badges.astro';
import { getTopics, getTerms, tracks, trackTitle, trackIntro, groups, groupTitle } from '../../lib/data';
import { t, faDigits, type Lang } from '../../i18n/ui';

export function getStaticPaths() { return [{ params: { lang: 'en' } }, { params: { lang: 'fa' } }]; }
const lang = Astro.params.lang as Lang;
const s = t(lang);
const topics = await getTopics(lang);
const terms = await getTerms(lang);
const n = (x: number) => faDigits(x, lang);
const hurry = topics.filter((x) => x.data.track === '0');
---
<Base lang={lang} path="">
  <section class="relative overflow-hidden border-b" style="border-color:var(--border)">
    <div class="skeleton-dot absolute inset-0 opacity-60 [mask-image:linear-gradient(to_bottom,black,transparent)]"></div>
    <div class="relative mx-auto max-w-4xl px-4 py-20 text-center md:py-28">
      <span class="chip mb-6" style="color:var(--accent);background:var(--accent-soft);border-color:transparent">{s.tagline}</span>
      <h1 class="text-4xl font-extrabold leading-tight tracking-tight md:text-6xl">{s.heroTitle}</h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg" style="color:var(--fg-muted)">{s.heroSub}</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href={`/${lang}/topics/de-role-overview/`} class="rounded-xl px-6 py-3 font-semibold text-white shadow-lg" style="background:var(--accent)">{s.startLearning}</a>
        <a href={`/${lang}/glossary/`} class="rounded-xl border px-6 py-3 font-semibold" style="border-color:var(--border);background:var(--bg-card)">{s.openGlossary}</a>
      </div>
      <dl class="mx-auto mt-14 grid max-w-2xl grid-cols-2 gap-4 sm:grid-cols-4">
        {[[tracks.length, s.stats.tracks], [topics.filter((x) => x.data.type !== 'problem').length, s.stats.topics], [topics.filter((x) => x.data.type === 'problem').length, s.stats.problems], [terms.length, s.stats.terms]].map(([v, l]) => (
          <div><dd class="text-3xl font-bold" style="color:var(--accent)">{n(v as number)}</dd><dt class="text-xs" style="color:var(--fg-muted)">{l}</dt></div>
        ))}
      </dl>
    </div>
  </section>

  <main class="mx-auto max-w-7xl px-4 py-14">
    <section class="mb-14">
      <h2 class="mb-1 text-2xl font-bold">{s.inAHurry}</h2>
      <p class="mb-5" style="color:var(--fg-muted)">{trackIntro(tracks[0], lang)}</p>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {hurry.map((x) => (
          <a href={`/${lang}/topics/${x.data.tid}/`} class="card card-hover block p-4">
            <div class="mb-2 text-xs font-semibold" style="color:var(--accent)">{n(x.data.num)}</div>
            <div class="font-semibold">{x.data.title}</div>
            <p class="mt-1 line-clamp-2 text-sm" style="color:var(--fg-muted)">{x.data.summary}</p>
            <div class="mt-3"><Badges lang={lang} level={x.data.level} priority={x.data.priority} hours={x.data.est_hours} /></div>
          </a>
        ))}
      </div>
    </section>

    <section class="mb-14 card p-5" data-hours-left={JSON.stringify(Object.fromEntries(topics.filter((x) => x.data.priority === 'P0').map((x) => [x.data.tid, x.data.est_hours])))}>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <div class="font-semibold">{s.progress}</div>
          <div class="text-sm" style="color:var(--fg-muted)">P0 · <span class="text-xl font-bold" style="color:var(--accent)" data-hours-left={JSON.stringify(Object.fromEntries(topics.filter((x) => x.data.priority === 'P0').map((x) => [x.data.tid, x.data.est_hours])))}>{topics.filter((x) => x.data.priority === 'P0').reduce((a, x) => a + x.data.est_hours, 0)}</span> {s.hoursLeft}</div>
        </div>
        <a href={`/${lang}/study-plan/`} class="rounded-lg border px-4 py-2 text-sm font-semibold" style="border-color:var(--border)">{s.plan} →</a>
      </div>
    </section>

    {groups.filter((g) => g.id !== 'start').map((g) => (
      <section class="mb-12">
        <h2 class="mb-4 text-xl font-bold">{groupTitle(g, lang)}</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {g.tracks.map((id) => {
            const tr = tracks.find((x) => x.id === id)!;
            const list = topics.filter((x) => x.data.track === id);
            const hrs = list.reduce((a, x) => a + x.data.est_hours, 0);
            return (
              <a href={`/${lang}/tracks/${id}/`} class="card card-hover flex flex-col p-5">
                <div class="flex items-center justify-between">
                  <span class="grid h-8 w-8 place-items-center rounded-lg text-sm font-bold" style="background:var(--accent-soft);color:var(--accent)">{n(Number(id))}</span>
                  <span class="text-xs" style="color:var(--fg-muted)">{'★'.repeat(tr.weight)}<span class="opacity-30">{'★'.repeat(5 - tr.weight)}</span></span>
                </div>
                <h3 class="mt-3 text-lg font-semibold leading-snug">{trackTitle(tr, lang)}</h3>
                <p class="mt-1 line-clamp-3 flex-1 text-sm" style="color:var(--fg-muted)">{trackIntro(tr, lang) || list.slice(0, 4).map((x) => x.data.title).join(' · ')}</p>
                <div class="mt-4 text-xs" style="color:var(--fg-muted)">{n(list.length)} {s.topics} · ~{n(hrs)} {s.hours}</div>
                <div class="mt-2 h-1.5 overflow-hidden rounded-full" style="background:var(--bg-soft)" data-track-progress={list.map((x) => x.data.tid).join(',')}>
                  <div data-bar class="h-full rounded-full" style="background:var(--accent);width:0"></div><span data-label hidden></span>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    ))}
  </main>
</Base>
