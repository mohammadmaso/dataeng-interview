---
import Base from '../../../layouts/Base.astro';
import PagefindMeta from '../../../components/PagefindMeta.astro';
import { t, faDigits, type Lang } from '../../../i18n/ui';
import { ta } from '../../../i18n/app';
import { getTopics } from '../../../lib/data';
import { chapters, chapterQuestions } from '../../../lib/qdata';

export function getStaticPaths() {
  return ['en', 'fa'].flatMap((lang) => chapters.map((c) => ({ params: { lang, chapter: c.slug } })));
}
const lang = Astro.params.lang as Lang;
const s = t(lang);
const a = ta(lang);
const n = (x: number) => faDigits(x, lang);
const slug = Astro.params.chapter!;
const { title, rows } = chapterQuestions(slug, lang);
const translated = rows.some((r) => r.tr);
const meta = chapters.find((c) => c.slug === slug)!;
const topics = await getTopics(lang);
const related = topics.filter((x) => meta.topics.includes(x.data.tid));
const siblings = chapters.filter((c) => c.vol === meta.vol);
const dLabel = [a.qEasy, a.qMid, a.qHard];
---
<Base lang={lang} title={`${title} — ${s.qbTitle}`} description={`${n(rows.length)} ${s.qbCount}`} path={`questions/${slug}/`}>
  <main class="mx-auto max-w-4xl px-4 py-10" data-chapter={slug}>
    <nav class="mb-3 text-sm" style="color:var(--fg-muted)"><a href={`/${lang}/`} class="hover:underline">{s.home}</a> / <a href={`/${lang}/questions/`} class="hover:underline">{s.qbTitle}</a></nav>
    <h1 class="text-3xl font-extrabold tracking-tight md:text-4xl" data-pagefind-meta="title">{title}</h1>
    <p class="mt-2" style="color:var(--fg-muted)">{n(rows.length)} {s.qbCount}{lang === 'fa' && !translated ? ' (پاسخ‌ها انگلیسی)' : ''} · <span id="q-summary"></span></p>
    <div class="mt-4 flex flex-wrap items-center gap-2">
      <a href={`/${lang}/review/?chapter=${slug}`} class="rounded-xl px-4 py-2 text-sm font-semibold text-white" style="background:var(--accent)">▶ {a.qPracticeChapter}</a>
      <a href={`/${lang}/mock/?chapters=${slug}`} class="rounded-xl border px-4 py-2 text-sm font-semibold" style="border-color:var(--border)">{a.mock}</a>
      <button id="q-random" type="button" class="rounded-xl border px-4 py-2 text-sm font-semibold" style="border-color:var(--border)">🎲 {a.qRandom}</button>
      <button id="q-bil" type="button" class="chip hover:border-[var(--accent)]" aria-pressed="false"></button>
    </div>
    {related.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {related.map((x) => <a class="chip hover:border-[var(--accent)]" href={`/${lang}/topics/${x.data.tid}/`}>{x.data.title}</a>)}
      </div>
    )}
    <div class="sticky top-14 z-20 -mx-4 mt-6 flex flex-wrap items-center gap-2 border-b px-4 py-3 backdrop-blur" style="border-color:var(--border);background:color-mix(in srgb,var(--bg) 88%,transparent)">
      <input id="q-filter" type="search" placeholder={s.qbFilter} class="min-w-0 flex-1 basis-40 rounded-lg border px-3 py-2 text-sm" style="border-color:var(--border);background:var(--bg-soft);color:var(--fg)" />
      <select id="q-diff" aria-label={a.qDifficulty} title={a.qEstimated} class="rounded-lg border px-2 py-2 text-sm" style="border-color:var(--border);background:var(--bg-soft);color:var(--fg)">
        <option value="">{a.qDifficulty}: {a.qAny}</option><option value="0">{a.qEasy}</option><option value="1">{a.qMid}</option><option value="2">{a.qHard}</option>
      </select>
      <select id="q-status" aria-label={a.qStatus} class="rounded-lg border px-2 py-2 text-sm" style="border-color:var(--border);background:var(--bg-soft);color:var(--fg)">
        <option value="">{a.qStatus}: {a.qAll}</option><option value="new">{a.qNew}</option><option value="missed">{a.qMissed}</option><option value="due">{a.qDue}</option><option value="mastered">{a.qMastered}</option><option value="saved">{a.qSaved}</option>
      </select>
      <span id="q-count" class="text-xs" style="color:var(--fg-muted)"></span>
      <button id="q-expand" class="rounded-lg border px-3 py-2 text-xs font-semibold" style="border-color:var(--border)">{s.qbExpand}</button>
      <button id="q-collapse" class="rounded-lg border px-3 py-2 text-xs font-semibold" style="border-color:var(--border)">{s.qbCollapse}</button>
    </div>

    <div data-pagefind-body>
    <PagefindMeta kind="questions" />
    <ol id="q-list" class="mt-4 grid gap-2">
      {rows.map((q, i) => (
        <li class="q-item card" id={q.id} data-d={q.d} data-q={q.q.toLowerCase()}>
          <details class="group">
            <summary class="flex cursor-pointer list-none items-start gap-3 p-4">
              <span class="mt-0.5 text-xs font-bold tabular-nums" style="color:var(--accent)">{n(i + 1)}</span>
              <span class="q-text flex-1 font-medium leading-snug" dir="auto" style="text-align:start">{q.q}</span>
              <span class={`chip q-diff d${q.d}`} title={a.qEstimated}>{dLabel[q.d]}</span>
              <svg class="mt-1 h-3 w-3 shrink-0 transition group-open:rotate-90 rtl:rotate-180 rtl:group-open:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m9 6 6 6-6 6"/></svg>
            </summary>
            <div class="prose max-w-none border-t px-4 py-4 dark:prose-invert" dir="auto" style="border-color:var(--border);text-align:start" set:html={q.a} />
          </details>
        </li>
      ))}
    </ol>
    </div>
    <p id="q-none" class="mt-6 hidden text-center" style="color:var(--fg-muted)">{a.qNoMatch}</p>

    <section class="mt-12 flex flex-wrap gap-2">
      {siblings.map((c) => <a href={`/${lang}/questions/${c.slug}/`} class={`chip ${c.slug === slug ? 'chip-P0' : ''}`}>{c.title}</a>)}
    </section>
    <p class="mt-8 text-sm" style="color:var(--fg-muted)">{s.qbSource} <a class="underline" href="https://github.com/OBenner/data-engineering-interview-questions">OBenner/data-engineering-interview-questions</a>. {s.qbSourceTail}</p>
    <p class="mt-2 text-xs" style="color:var(--fg-muted)">{a.qEstimated}</p>
  </main>
  <script>import '../../../scripts/questions';</script>
</Base>
