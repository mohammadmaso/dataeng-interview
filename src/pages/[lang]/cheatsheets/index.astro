---
import Base from '../../../layouts/Base.astro';
import { getTopics, tracks, trackTitle } from '../../../lib/data';
import { extractFlashcards } from '../../../lib/flashcards';
import { ta } from '../../../i18n/app';
import { faDigits, t, type Lang } from '../../../i18n/ui';
export function getStaticPaths() { return [{ params: { lang: 'en' } }, { params: { lang: 'fa' } }]; }
const lang = Astro.params.lang as Lang;
const a = ta(lang);
const s = t(lang);
const topics = await getTopics(lang);
const n = (x: number) => faDigits(x, lang);
const rows = tracks.map((tr) => {
  const list = topics.filter((x) => x.data.track === tr.id);
  return { tr, topics: list.length, cards: list.reduce((c, x) => c + extractFlashcards(x.body ?? '').length, 0) };
});
---
<Base lang={lang} title={a.csTitle} description={a.csSub} path="cheatsheets/">
  <main class="mx-auto max-w-5xl px-4 py-12">
    <h1 class="text-4xl font-extrabold tracking-tight">{a.csTitle}</h1>
    <p class="mt-3 max-w-2xl text-lg" style="color:var(--fg-muted)">{a.csSub}</p>
    <div class="mt-8 grid gap-3 sm:grid-cols-2">
      {rows.map(({ tr, topics: tn, cards }) => (
        <a href={`/${lang}/cheatsheets/${tr.id}/`} class="card card-hover flex items-center gap-3 p-4">
          <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg text-sm font-bold" style="background:var(--accent-soft);color:var(--accent)">{n(Number(tr.id))}</span>
          <span class="min-w-0 flex-1"><span class="block font-semibold">{trackTitle(tr, lang)}</span><span class="text-xs" style="color:var(--fg-muted)">{n(tn)} {s.topics} · {n(cards)} {a.csFlash}</span></span>
          <span aria-hidden="true">📄</span>
        </a>
      ))}
    </div>
  </main>
</Base>
