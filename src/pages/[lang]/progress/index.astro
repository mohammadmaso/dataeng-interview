---
import Base from '../../../layouts/Base.astro';
import { ta } from '../../../i18n/app';
import type { Lang } from '../../../i18n/ui';
export function getStaticPaths() { return [{ params: { lang: 'en' } }, { params: { lang: 'fa' } }]; }
const lang = Astro.params.lang as Lang;
const a = ta(lang);
---
<Base lang={lang} title={a.pgrTitle} description={a.pgrSub} path="progress/">
  <main class="mx-auto max-w-5xl px-4 py-10">
    <h1 class="text-3xl font-extrabold tracking-tight md:text-4xl">{a.pgrTitle}</h1>
    <p class="mt-2 mb-6" style="color:var(--fg-muted)">{a.pgrSub}</p>
    <div id="progress-app"></div>
  </main>
  <script>import '../../../scripts/progress';</script>
</Base>
