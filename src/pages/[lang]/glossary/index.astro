---
import Base from '../../../layouts/Base.astro';
import { getTerms, slugOf } from '../../../lib/data';
import { t, faDigits, type Lang } from '../../../i18n/ui';
import { ta } from '../../../i18n/app';

export function getStaticPaths() { return [{ params: { lang: 'en' } }, { params: { lang: 'fa' } }]; }
const lang = Astro.params.lang as Lang;
const s = t(lang);
const a = ta(lang);
const terms = await getTerms(lang);
const cats = [...new Set(terms.map((x) => x.data.category))].sort();
const key = (x: (typeof terms)[number]) => (lang === 'fa' ? x.data.term_en ?? x.data.term : x.data.term);
const sorted = [...terms].sort((a, b) => key(a).localeCompare(key(b), 'en'));
const letters = [...new Set(sorted.map((x) => key(x)[0].toUpperCase()))];
---
<Base lang={lang} title={s.glossaryTitle} description={s.glossarySub} path="glossary/">
  <main class="mx-auto max-w-5xl px-4 py-12">
    <h1 class="text-4xl font-extrabold tracking-tight">{s.glossaryTitle}</h1>
    <p class="mt-3 max-w-2xl text-lg" style="color:var(--fg-muted)">{s.glossarySub}</p>

    <div class="mt-4 flex flex-wrap gap-2">
      <a href={`/${lang}/glossary/quiz/`} class="rounded-xl px-4 py-2 text-sm font-semibold text-white" style="background:var(--accent)">🔤 {a.quizMe}</a>
      <button type="button" data-random="term" class="rounded-xl border px-4 py-2 text-sm font-semibold" style="border-color:var(--border)">🎲 {a.randomTerm}</button>
    </div>
    <div class="sticky top-14 z-20 -mx-4 mt-6 border-b px-4 py-3 backdrop-blur" style="border-color:var(--border);background:color-mix(in srgb,var(--bg) 88%,transparent)">
      <input id="g-filter" type="search" placeholder={s.searchTerms} class="w-full rounded-lg border px-3 py-2 text-sm" style="border-color:var(--border);background:var(--bg-soft);color:var(--fg)" />
      <div class="mt-2 flex flex-wrap gap-1.5" id="g-cats">
        <button class="chip chip-P0" data-cat="">{s.filterAll}</button>
        {cats.map((c) => <button class="chip" data-cat={c}>{c}</button>)}
      </div>
    </div>

    <div class="mt-3 flex flex-wrap gap-1 text-xs" dir="ltr">
      {letters.map((l) => <a href={`#l-${l}`} class="grid h-6 w-6 place-items-center rounded-md hover:bg-[var(--bg-soft)]">{l}</a>)}
    </div>

    <div id="g-list">
      {letters.map((l) => (
        <section id={`l-${l}`} class="g-sec mt-8">
          <h2 class="mb-3 text-2xl font-bold" style="color:var(--accent)" dir="ltr">{l}</h2>
          <ul class="grid gap-3 sm:grid-cols-2">
            {sorted.filter((x) => key(x)[0].toUpperCase() === l).map((x) => (
              <li class="g-item" data-cat={x.data.category} data-s={(x.data.term + ' ' + (x.data.term_en ?? '') + ' ' + x.data.aliases.join(' ')).toLowerCase()}>
                <a href={`/${lang}/glossary/${slugOf(x)}/`} class="card card-hover block h-full p-4">
                  <div class="flex items-start justify-between gap-2"><span class="font-semibold">{x.data.term}</span><span class="chip">{x.data.category}</span></div>
                  <p class="mt-1 text-sm" style="color:var(--fg-muted)">{x.data.short}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
    <p id="g-empty" class="mt-10 hidden text-center" style="color:var(--fg-muted)">{s.noResults}</p>
  </main>
  <script is:inline>
    (function () {
      var f = document.getElementById('g-filter'), items = [].slice.call(document.querySelectorAll('.g-item')), secs = [].slice.call(document.querySelectorAll('.g-sec')), cat = '';
      function upd() {
        var v = f.value.trim().toLowerCase(), any = false;
        items.forEach(function (li) { var ok = (!v || li.getAttribute('data-s').indexOf(v) > -1) && (!cat || li.getAttribute('data-cat') === cat); li.style.display = ok ? '' : 'none'; if (ok) any = true; });
        secs.forEach(function (sec) { sec.style.display = sec.querySelector('.g-item:not([style*="none"])') ? '' : 'none'; });
        document.getElementById('g-empty').classList.toggle('hidden', any);
      }
      f.addEventListener('input', upd);
      document.getElementById('g-cats').addEventListener('click', function (e) {
        var b = e.target.closest('button'); if (!b) return; cat = b.getAttribute('data-cat');
        [].forEach.call(this.children, function (x) { x.classList.toggle('chip-P0', x === b); }); upd();
      });
    })();
  </script>
</Base>
