---
import { t, languages, type Lang } from '../i18n/ui';
const { lang, path } = Astro.props as { lang: Lang; path: string }; // path = url without lang prefix e.g. "topics/x/"
const s = t(lang);
const other: Lang = lang === 'en' ? 'fa' : 'en';
const nav = [
  { href: `/${lang}/`, label: s.learn },
  { href: `/${lang}/questions/`, label: s.questions },
  { href: `/${lang}/glossary/`, label: s.glossary },
  { href: `/${lang}/study-plan/`, label: s.plan },
  { href: `/${lang}/resources/`, label: s.resources },
];
---
<header class="sticky top-0 z-30 border-b backdrop-blur" style="border-color:var(--border);background:color-mix(in srgb,var(--bg) 85%,transparent)">
  <div class="mx-auto flex h-14 max-w-7xl items-center gap-3 px-4">
    <a href={`/${lang}/`} class="flex items-center gap-2 font-bold tracking-tight">
      <span class="grid h-7 w-7 place-items-center rounded-lg text-sm text-white" style="background:var(--accent)">DE</span>
      <span class="font-title hidden sm:inline">{s.siteName}</span>
    </a>
    <nav class="ms-4 hidden items-center gap-1 md:flex">
      {nav.map((n) => <a href={n.href} class="rounded-lg px-3 py-1.5 text-sm font-medium hover:bg-[var(--bg-soft)]" style="color:var(--fg-muted)">{n.label}</a>)}
    </nav>
    <div class="ms-auto flex items-center gap-2">
      <button id="open-search" class="flex items-center gap-2 rounded-lg border px-3 py-1.5 text-sm" style="border-color:var(--border);color:var(--fg-muted);background:var(--bg-soft)" aria-label={s.search}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span class="hidden sm:inline">{s.search}</span><kbd class="hidden rounded border px-1 text-[10px] sm:inline" style="border-color:var(--border)">/</kbd>
      </button>
      <a href={`/${other}/${path}`} hreflang={other} class="rounded-lg border px-2.5 py-1.5 text-sm font-semibold" style="border-color:var(--border)" data-lang-switch={other}>{languages[other]}</a>
      <button id="theme-toggle" class="grid h-8 w-8 place-items-center rounded-lg border" style="border-color:var(--border)" aria-label={s.theme}>
        <svg class="dark:hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="hidden dark:block" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </div>
  </div>
  <nav class="flex gap-1 overflow-x-auto border-t px-3 py-1 md:hidden" style="border-color:var(--border)">
    {nav.map((n) => <a href={n.href} class="whitespace-nowrap rounded-lg px-3 py-1 text-sm font-medium" style="color:var(--fg-muted)">{n.label}</a>)}
  </nav>
</header>
